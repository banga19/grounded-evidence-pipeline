# Copy to .env and fill in when wiring live providers. Demo mode needs none of these.

# --- Azure AI Foundry: Bing Grounding tool + agent model -------------------
# Create a Foundry project, connect a "Grounding with Bing" resource, deploy
# an agent, then set the project endpoint here.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=

# --- Optional LLM scorer (judge layer over the lexical baseline) -----------
# Set LLM_SCORER_ENABLED=1 to require the scorer hook; leave unset for demo.
LLM_SCORER_ENABLED=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
